package oauth4cj

/**
 * OAuth2 Authorization
 */
public class OAuth2Authorization {
    private var code: String = ""
    private var state: String = ""

    /**
     * Constructor
     */
    public init() {}

    /**
     * get the authorization code generated by the authorization server
     *
     * @return String authorization code
     */
    public func getCode(): String {
        return code
    }

    /**
     * set the authorization code
     *
     * @Param code authorization code
     */
    public func setCode(code: String): Unit {
        this.code = code
    }

    /**
     * get state
     *
     * @return String state
     */
    public func getState(): String {
        return state
    }

    /**
     * set state
     *
     * @Param state state
     */
    public func setState(state: String): Unit  {
        this.state = state
    }
}